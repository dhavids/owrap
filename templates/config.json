{
    "_comment": "OWrap configuration file. Copy to ~/.owrap/configs/base.json",
    "owrap_runner_enabled": true,
    "owrap_context_manager_enabled": true,
    "default_research": "my_project",
    "workspace": "/home/user",
    "research_root": "/home/user/my_project/docs/research",
    "runner_allow_all": true,
    "permit_bypass_all": false,
    "runner_use_oread": true,
    "context_injection_enabled": true,
    "use_multiple_servers": false,
    "max_servers": 1,
    "min_servers": 1,
    "idle_shutdown_s": 300,
    "daemon_interval_s": 10,
    "ctx_check_interval_s": 300,
    "daemon_default_model": "opencode/deepseek-v4-flash-free",
    "runner_model": "opencode/deepseek-v4-flash-free",
    "context_manager_model": "opencode/deepseek-v4-flash-free",
    "context_fallback_model": "opencode/deepseek-v4-flash-free",
    "msg_kill_s": 30,
    "task_kill_s": 60,
    "exec_kill_s": 120,
    "stall_notify_s": 120,
    "watchdog_poll_s": 10,
    "expected_duration_msg": 4,
    "expected_duration_read": 4,
    "expected_duration_task": 6,
    "expected_duration_exec": 30,
    "max_requests_per_server": 10
}
