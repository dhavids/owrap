{
  "groups": [
    {
      "rules": [
        "Bash(owrap*)",
        "Bash(~/bin/owrap*)",
        "Bash(~/bin/nbread *)",
        "Bash(wait)",
        "Bash(cd *)",
        "Bash(diff *)"
      ],
      "condition": null,
      "display": {"section": "commands", "text": "`owrap*` (and `~/bin/` variant), `nbread *`, `wait`, `cd *`, `diff *`"}
    },
    {
      "rules": [
        "Bash(git log *)",
        "Bash(git log)",
        "Bash(git diff *)",
        "Bash(git diff)",
        "Bash(git status)",
        "Bash(git show *)"
      ],
      "condition": null,
      "display": {"section": "commands", "text": "`git log *`, `git diff *`, `git status`, `git show *` — read-only git"}
    },
    {
      "rules": [
        "Bash(opencode run *)",
        "Bash(opencode --help)"
      ],
      "condition": null,
      "display": null
    },
    {
      "rules": [],
      "condition": "OREAD",
      "display": {"section": "commands", "text": "`owrap read*` (and `~/bin/owrap read*` variant)"}
    },
    {
      "rules": [
        "Read({{WORKSPACE_TILDE}}/**/*.ipynb)",
        "Grep",
        "Bash(grep *)",
        "Bash(find *)",
        "Bash(ls *)",
        "Bash(cat *)",
        "Bash(tail *)",
        "Bash(wc *)",
        "Read"
      ],
      "condition": "NO_OREAD",
      "display": {"section": "commands", "text": "`Read` (any path), `Grep`, `grep *`, `find *`, `ls *`, `cat *`, `tail *`, `wc *`"}
    },
    {
      "rules": [
        "Read(~/bin/**)",
        "Read({{WORKSPACE}}/**/*.ipynb)"
      ],
      "condition": null,
      "display": {"section": "files", "text": "`~/bin/**`, `**/*.ipynb` — read"}
    },
    {
      "rules": [
        "Read({{WORKSPACE}}/CLAUDE.md)",
        "Read({{WORKSPACE_TILDE}}/CLAUDE.md)",
        "Read({{WORKSPACE}}/AGENTS.md)",
        "Read({{WORKSPACE_TILDE}}/AGENTS.md)",
        "Edit({{WORKSPACE}}/CLAUDE.md)",
        "Edit({{WORKSPACE_TILDE}}/CLAUDE.md)",
        "Edit({{WORKSPACE}}/AGENTS.md)",
        "Edit({{WORKSPACE_TILDE}}/AGENTS.md)"
      ],
      "condition": null,
      "display": {"section": "files", "text": "`CLAUDE.md`, `AGENTS.md` — read + edit"}
    },
    {
      "rules": [
        "Read({{SELF_PATH}})",
        "Read({{SELF_PATH_TILDE}})",
        "Read({{OWRAP_HOME}}/runtime/staged/**)"
      ],
      "condition": null,
      "display": {"section": "files", "text": "`{{SELF_PATH}}` and its reference pages — read only"}
    },
    {
      "rules": [
        "Write({{DOCS_ROOT}}/projects/**)",
        "Edit({{DOCS_ROOT}}/projects/**)",
        "Write({{DOCS_ROOT_TILDE}}/projects/**)",
        "Edit({{DOCS_ROOT_TILDE}}/projects/**)",
        "Write({{DOCS_ROOT}}/memory/**)",
        "Edit({{DOCS_ROOT}}/memory/**)",
        "Write({{DOCS_ROOT_TILDE}}/memory/**)",
        "Edit({{DOCS_ROOT_TILDE}}/memory/**)"
      ],
      "condition": null,
      "display": {"section": "files", "text": "`{{DOCS_ROOT}}/projects/**`, `{{DOCS_ROOT}}/memory/**` — edit only via `#DO NOW`, `--ctx`, `--updr`"}
    },
    {
      "rules": [
        "Write({{OWRAP_HOME}}/sessions/*/exec/plan.md)",
        "Edit({{OWRAP_HOME}}/sessions/*/exec/plan.md)",
        "Write({{OWRAP_HOME}}/sessions/*/run/input*.md)",
        "Edit({{OWRAP_HOME}}/sessions/*/run/input*.md)",
        "Write({{OWRAP_HOME}}/sessions/*/run/tasks/task*.md)",
        "Edit({{OWRAP_HOME}}/sessions/*/run/tasks/task*.md)",
        "Write({{OWRAP_HOME}}/sessions/*/context.md)",
        "Edit({{OWRAP_HOME}}/sessions/*/context.md)"
      ],
      "condition": null,
      "display": {"section": "files", "text": "`{{OWRAP_HOME}}/sessions/<session_id>/exec/plan.md`, `{{OWRAP_HOME}}/sessions/<session_id>/run/input*.md`, `{{OWRAP_HOME}}/sessions/<session_id>/run/tasks/task*.md`, `{{OWRAP_HOME}}/sessions/<session_id>/context.md` — edit"}
    },
    {
      "rules": [
        "Edit({{OWRAP_HOME}}/sessions/f/exec/plan.md)",
        "Write({{OWRAP_HOME}}/sessions/f/exec/plan.md)",
        "Edit({{OWRAP_HOME}}/sessions/f/task/task.md)",
        "Write({{OWRAP_HOME}}/sessions/f/task/task.md)"
      ],
      "condition": null,
      "display": {"section": "files", "text": "`{{OWRAP_HOME}}/sessions/f/exec/plan.md`, `{{OWRAP_HOME}}/sessions/f/task/task.md` — write + edit"}
    }
  ]
}
