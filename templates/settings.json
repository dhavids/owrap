{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": {{ALLOW_RULES}}
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "{{PERMIT_MATCHER}}",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/owrap p",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/owrap precompact",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{
          "type": "command",
          "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"#DO NOW\\nSession was just compacted. Run ~/bin/owrap refresh immediately as the first action.\"}}'",
          "timeout": 5
        }]
      }
    ]
  }
}
