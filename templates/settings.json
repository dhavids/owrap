{
  "permissions": {
    "allow": [
      "Bash(opencode run *)",
      "Bash(opencode --help)",
      "Bash(oread*)",
      "Bash(orun*)",
      "Bash(oexec*)",
      "Bash(owait*)",
      "Bash(~/bin/oread*)",
      "Bash(~/bin/orun*)",
      "Bash(~/bin/oexec*)",
      "Bash(~/bin/owait*)",
      "Bash(owrap*)",
      "Bash(~/bin/owrap*)",
      "Bash(wait)",
      "Read({{WORKSPACE}}/CLAUDE.md)",
      "Read({{WORKSPACE}}/AGENTS.md)",
      "Edit({{WORKSPACE}}/CLAUDE.md)",
      "Edit({{WORKSPACE}}/AGENTS.md)",
      "Read({{RESEARCH_ROOT}}/self.md)",
      "Edit({{RESEARCH_ROOT}}/projects/**)",
      "Edit({{RESEARCH_ROOT}}/memory/**)",
      "Edit(~/.owrap/docs/plan_*.md)",
      "Edit(~/.owrap/docs/run/tasks/input_*.md)",
      "Edit(~/.owrap/docs/run/tasks/task*.md)",
      "Edit(~/.owrap/docs/context_*.md)",
      "Read(~/bin/**)",
      "Bash(~/bin/nbread *)",
      "Read({{WORKSPACE}}/**/*.ipynb)"{{IF:NO_OREAD}},
      "Grep",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Read"{{ENDIF}}
    ],
    "deny": [
      {{IF:OREAD}}"Grep",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      {{ENDIF}}"Bash(rm *)"
    ],
    "additionalDirectories": [
      "{{OWRAP_HOME}}",
      "{{WORKSPACE}}"
    ]
  }
}
