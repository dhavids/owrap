  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(opencode run *)",
      "Bash(opencode --help)",
      "Bash(oread *)",
      "Bash(orun *)",
      "Bash(oexec *)",
      "Bash(owait *)",
      "Bash(~/bin/oread *)",
      "Bash(~/bin/orun *)",
      "Bash(~/bin/oexec *)",
      "Bash(~/bin/owait *)",
      "Bash(owrap *)",
      "Bash(~/bin/owrap *)",
      "Bash(wait)",
      "Read(<project_root>/CLAUDE.md)",
      "Read(<project_root>/AGENTS.md)",
      "Edit(<project_root>/CLAUDE.md)",
      "Edit(<project_root>/AGENTS.md)",
      "Read(<research_root>/self.md)",
