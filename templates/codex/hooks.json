{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{PERMIT_COMMAND}}",
            "timeout": 20,
            "statusMessage": "Checking owrap permission"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{PERMIT_COMMAND}}",
            "timeout": 20,
            "statusMessage": "Checking owrap permission"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "{{CTX_COMMAND}}",
            "timeout": 15,
            "statusMessage": "Saving owrap context"
          }
        ]
      }
    ]
  }
}
