#!/bin/bash
if [ -z "$OWRAP_HOME" ]; then
  if [ -f "$HOME/.owrap_home" ]; then
    OWRAP_HOME="$(cat "$HOME/.owrap_home")"
  else
    OWRAP_HOME="$HOME/.owrap"
  fi
fi
mkdir -p "$OWRAP_HOME/sessions/_index/claude"
mkdir -p "$OWRAP_HOME/sessions/_index/opencode"
mkdir -p "$OWRAP_HOME/sessions/_index/codex"

_resolve_owrap_session() {
  local SID="${SESSION_ID:-}"
  local CCSID="${CLAUDE_CODE_SESSION_ID:-}"
  local PTR="$OWRAP_HOME/sessions/_index/claude/${CCSID}"
  if [ -z "$SID" ] && [ -n "$CCSID" ] && [ -f "$PTR" ]; then
    SID=$(cat "$PTR")
  fi
  local CID="${CODEX_SESSION_ID:-}"
  local CID_PTR="$OWRAP_HOME/sessions/_index/codex/${CID}"
  if [ -z "$SID" ] && [ -n "$CID" ] && [ -f "$CID_PTR" ]; then
    SID=$(cat "$CID_PTR")
  fi
  local OID="${OPENCODE_RUN_ID:-}"
  local OID_PTR="$OWRAP_HOME/sessions/_index/opencode/${OID}"
  if [ -z "$SID" ] && [ -n "$OID" ] && [ -f "$OID_PTR" ]; then
    SID=$(cat "$OID_PTR")
  fi
  export SESSION_ID="$SID"
  # Current layout is one directory per session; fall back to the
  # legacy flat <sid>.session file for older, not-yet-migrated sessions.
  local SF="$OWRAP_HOME/sessions/${SID}/.session"
  if [ ! -f "$SF" ]; then
    SF="$OWRAP_HOME/sessions/${SID}.session"
  fi
  if [ -f "$SF" ]; then
    export OWRAP_SESSION=$(grep "^session_id=" "$SF" | cut -d= -f2)
    export OWRAP_RESEARCH=$(grep "^research=" "$SF" | cut -d= -f2)
    export OWRAP_SERVER_URL=$(grep "^server_url=" "$SF" | cut -d= -f2)
  fi
}
_resolve_owrap_session

tmpout=$(mktemp)
(cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.cli "$@") 2>&1 | tee "$tmpout"
exit_code=${PIPESTATUS[0]}
new_sid=$(grep "^__OWRAP_EXPORT__ SESSION_ID=" "$tmpout" | tail -n1 | sed 's|^__OWRAP_EXPORT__ SESSION_ID=||')
rm -f "$tmpout"
if [ -n "$new_sid" ]; then
  export SESSION_ID="$new_sid"
fi
exit "$exit_code"
