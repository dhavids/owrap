#!/bin/bash
mkdir -p "$HOME/.owrap/sessions"
SESSION_FILE="$HOME/.owrap/sessions/${CLAUDE_CODE_SESSION_ID}.session"
[ -f "$SESSION_FILE" ] && export OWRAP_SESSION=$(grep "^session_id=" "$SESSION_FILE" | cut -d= -f2)
[ -f "$SESSION_FILE" ] && export OWRAP_RESEARCH=$(grep "^research=" "$SESSION_FILE" | cut -d= -f2)
[ -f "$SESSION_FILE" ] && export OWRAP_SERVER_URL=$(grep "^server_url=" "$SESSION_FILE" | cut -d= -f2)
case "$1" in
  start|refresh|restart) cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.runner "$1" --shell-pid "$PPID" --session-file "$SESSION_FILE" "${@:2}" ;;
  stop)                  cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.runner stop --session-file "$SESSION_FILE" "${@:2}" ;;
  end)                   cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.runner end --session-file "$SESSION_FILE" ;;
  *)                     cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.runner "$@" ;;
esac
