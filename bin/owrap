#!/bin/bash
SESSION_FILE="$HOME/.owrap/session"
mkdir -p "$HOME/.owrap"
[ -f "$SESSION_FILE" ] && export OWRAP_SESSION=$(grep "^session_id=" "$SESSION_FILE" | cut -d= -f2)
[ -f "$SESSION_FILE" ] && export OWRAP_RESEARCH=$(grep "^research=" "$SESSION_FILE" | cut -d= -f2)
case "$1" in
  start|refresh) cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.runner "$1" --shell-pid "$PPID" --session-file "$SESSION_FILE" "${@:2}" ;;
  stop)          cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.runner stop --session-file "$SESSION_FILE" ;;
  *)             cd "<OWRAP_ROOT>" && <PYTHON> -m owrap.runner "$@" ;;
esac
